# --- Aspire API credentials (create these in Aspire: System Admin -> API) ---
ASPIRE_CLIENT_ID=your-aspire-client-id
ASPIRE_SECRET=your-aspire-secret

# Base + token endpoint (defaults shown; confirm the token path on your Aspire API credential page)
ASPIRE_BASE_URL=https://cloud-api.youraspire.com
ASPIRE_TOKEN_URL=https://cloud-api.youraspire.com/Authorization

# Shared secret the connector must send to reach this server (generate a long random string)
CONNECTOR_TOKEN=replace-with-a-long-random-string

# Which Aspire resources are queryable (read-only regardless)
ALLOWED_RESOURCES=Invoices,InvoiceOpportunities,Opportunities,WorkTickets,Receipts,Contacts,Properties,Payments,Companies

PORT=8080
